; One theory, [raven], with a qualified sub-namespace per directory
; (raven.runtime, raven.verification, ...).

(include_subdirs qualified)

(coq.theory
 (name raven)
 (theories stdpp iris Ltac2)
 (flags :standard -w -redundant-canonical-projection))

; [dune build @soundness]: the generic development up to the library
; soundness theorem, without examples.
(rule
 (alias soundness)
 (deps soundness/adequacy.vo)
 (action (progn)))

; [dune build @examples]: the verified examples (and everything they need).
(rule
 (alias examples)
 (deps examples/counter_monotonic.vo)
 (action (progn)))

; [dune build @tests]: analyzer regression tests.
(rule
 (alias tests)
 (deps tests/conditional_masks.vo tests/conditional_accesses.vo
   tests/argument_snapshots.vo tests/conditional_normalization.vo
   tests/atomic_accesses.vo)
 (action (progn)))
